# AI Model API Keys (isi salah satu atau beberapa)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Qwen (Alibaba DashScope / OpenAI-Compatible)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Default Active LLM Provider: gemini | qwen | openai | claude
DEFAULT_LLM_PROVIDER=gemini

# Database
DATABASE_URL=sqlite:///./competitor_radar.db
